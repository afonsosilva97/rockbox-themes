# Adwaitapod R3 (light) - base skin
# HiBy R3 Pro II, 480x720 portrait, touchscreen
# Generated by src/adwaitapod-r3/make_skins.py from adwaitapod-r3.sbs.in.
#
# Portrait touch redesign of adwaitapod by Dook (GPL-3.0):
# https://github.com/D0-0K/adwaitapod
#
# Layout
#   0-56     status bar: back (or lock), screen title (clock on the home
#            screen), battery % and icon
#   main menu (home screen)
#     56-504   list, 8 rows
#     512-592  clock widget, or the playing track
#     600-648  volume slider
#     660-708  shuffle and repeat buttons
#   other menus
#     56-720   list; 56-640 while playing, with a mini player below
#   quick screen
#     battery and back, volume and brightness sliders, Rockbox's items below
#
# Two layers: the first viewport draws backgrounds onto the backdrop buffer
# (%VB), so the text and lists above show it through instead of filling
# boxes. Images (%xd) are drawn after all text, so nothing that has text on
# it can be a foreground image.
#
# Key lock (power + volume up): the back button turns into a lock icon. The
# full lock screen is Now Playing's (.wps).
#
# Fonts
%Fl(2,26-Cantarell-Bold.fnt)
%Fl(3,22-Cantarell-Regular.fnt)
%Fl(4,28-Cantarell-Bold.fnt)
#
# Images for the backdrop layer (positions are on screen)
%xl(Bhcard,hcard.bmp,24,512)
%xl(Bvol,volbg.bmp,64,600)
%xl(Bvolcap,volcap.bmp,64,600)
%xl(Bshuf,pill.bmp,24,660,2)
%xl(Brep,pill.bmp,246,660,2)
%xl(Bqsbatt,qsbatt.bmp,24,24)
%xl(Bqsback,qsback.bmp,400,24)
# Images for the foreground (positions are in their viewport)
%xl(back,back.bmp,0,0)
%xl(lock,lock.bmp,0,0)
%xl(batt,batt.bmp,0,0,11)
%xl(battc,battc.bmp,0,0,11)
%xl(clockm,clockm.bmp,0,0,60)
%xl(clockh,clockh.bmp,0,0,12)
%xl(volf,volf.bmp,0,0,4)
%xl(volbk,volbk.bmp,0,0)
%xl(volknob,volknob.bmp,0,0)
%xl(shufp,shufp.bmp,0,0,2)
%xl(repp,repp.bmp,0,0,3)
%xl(mc1,mcorner.bmp,0,0,4)
%xl(mc2,mcorner.bmp,48,0,4)
%xl(mc3,mcorner.bmp,0,48,4)
%xl(mc4,mcorner.bmp,48,48,4)
%xl(mnoart,mnoart.bmp,0,0)
%xl(mplay,mplay.bmp,16,16,2)
%xl(bright,bright.bmp,0,0)
%xl(seekbk,seekbk.bmp,0,0)
%xl(seekknob,seekknob.bmp,0,0)
#
# ---------------- Which parts show ----------------
%?if(%cs, =, 10)<%VI(qs)%Vd(qs)|%Vd(sb)%?mh<%Vd(sbl)|%?if(%cs, =, 1)<|%Vd(sbk)>>%?if(%cs, =, 1)<%VI(home)%Vd(home)%?if(%mp, >, 1)<%Vd(minih)|%Vd(clock)>%?ps<%Vd(shon)|%Vd(shoff)>%?mm<%Vd(repoff)|%Vd(repon)|%Vd(repon)|%Vd(repon)|%Vd(repon)>|%?if(%mp, >, 1)<%VI(short)%Vd(mini)|%VI(full)>>>
#
# ---------------- Backdrop layer ----------------
# One line: when a line redraws, its band is cleared first, so everything on
# the backdrop must redraw with it.
%V(0,0,-,-,-)%VB
%dr(0,0,-,-,f7f7f7)%?if(%cs, =, 10)<%xd(Bqsbatt)%xd(Bqsback)|%dr(0,0,480,55,efefef)%dr(0,55,480,1,d6d7d6)%?if(%cs, =, 1)<%dr(0,504,480,1,d6d7d6)%?if(%mp, >, 1)<%xd(Bhcard)>%xd(Bvol)%xd(Bvolcap)%?ps<%xd(Bshuf,2)|%xd(Bshuf,1)>%?mm<%xd(Brep,1)|%xd(Brep,2)|%xd(Brep,2)|%xd(Brep,2)|%xd(Brep,2)>|%?if(%mp, >, 1)<%dr(0,640,480,80,efefef)%dr(0,640,480,1,d6d7d6)>>>
#
# ---------------- Status bar ----------------
# back: tap anywhere on the left of the bar
%Vl(sbk,0,0,96,56,-)
%T(0,0,-,-,cancel)
%Vl(sbk,20,16,24,24,-)
%xd(back)
%Vl(sbl,20,16,24,24,-)
%xd(lock)
#
# title: the clock on the home screen, else the list's title
%Vl(sb,96,14,288,27,2)
%Vf(292829)
%s%ac%?if(%cs, =, 1)<%?cf<%cH|%cl>:%cM|%?Lt<%Lt|%?cs<Rockbox|Now Playing|Recording|FM Radio|Playlist|Settings|Files|Database|Plugins|Quick Settings|Pitch|Rockbox|Playlists|Plugin|Menu|System|Time & Date|Bookmarks|Shortcuts|Track Info|USB|Rockbox>>>
#
%Vl(sb,356,16,72,23,3)
%Vf(292829)
%ar%bl%%
%Vl(sb,436,16,24,24,-)
%?bp<%xd(battc,%bl)|%xd(batt,%bl)>
#
# ---------------- Lists ----------------
%Vi(home,0,56,480,448,-)
%Vf(292829)
%Vi(full,0,56,480,664,-)
%Vf(292829)
%Vi(short,0,56,480,584,-)
%Vf(292829)
%Vi(qs,0,236,480,240,-)
%Vf(292829)
#
# ---------------- Home: clock widget (nothing playing) ----------------
# minute frames hold the face and the minute hand; the hour hand goes on top
%Vl(clock,24,516,72,72,-)
%xd(clockm,%cM)%xd(clockh,%cl)
#
%Vl(clock,112,524,344,29,4)
%Vf(292829)
%al%?if(%ck, <, 5)<Night|%?if(%ck, <, 12)<Morning|%?if(%ck, <, 17)<Afternoon|%?if(%ck, <, 21)<Evening|Night>>>>
%Vl(clock,112,558,344,23,3)
%Vf(6b6d6b)
%al%?cu<Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday> %?if(%ce, <, 10)<%ss(1,1,%ce)|%ce> %?cm<January|February|March|April|May|June|July|August|September|October|November|December>
#
# ---------------- Home: playing track (tap for Now Playing) ----------------
%Vl(minih,24,512,352,80,-)
%T(0,0,-,-,resumeplayback)
%Vl(minih,36,524,56,56,-)
%Cl(0,0,56,56,c,c)
%?C<%Cd%xd(mc1,1)%xd(mc2,2)%xd(mc3,3)%xd(mc4,4)|%xd(mnoart)>
%Vl(minih,104,526,264,27,2)
%Vf(292829)
%s%al%?it<%it|%fn>
%Vl(minih,104,556,264,23,3)
%Vf(6b6d6b)
%s%al%?ia<%ia|%?id<%id|>>
%Vl(minih,376,512,80,80,-)
%?mp<|%xd(mplay,2)|%xd(mplay,1)|%xd(mplay,2)|%xd(mplay,2)>
%T(0,0,-,-,play)
#
# ---------------- Home: volume ----------------
%Vl(home,24,612,24,24,-)
%?if(%pv, <, -60)<%xd(volf,1)|%?if(%pv, <, -35)<%xd(volf,2)|%?if(%pv, <, -15)<%xd(volf,3)|%xd(volf,4)>>>
# pill = static backdrop and cap at 64; the bar is a fill plus a D-shaped knob
%Vl(home,88,600,368,48,-)
%pv(0,0,368,48,volfill.bmp,backdrop,volbk,slider,volknob)
#
# ---------------- Home: shuffle and repeat ----------------
# The buttons are drawn on the backdrop. Text lines clear to it, so each
# button's area is covered by two blank lines that change with the state:
# they repaint the button when it's tapped. Labels change with it too.
%Vl(home,24,660,210,48,4)
%?ps< |  >
%?ps< |  >
%T(0,0,-,-,shuffle)
%Vl(home,44,672,24,24,-)
%?ps<%xd(shufp,2)|%xd(shufp,1)>
%Vl(shon,78,670,148,27,2)
%Vf(ffffff)
%al%?ps<Shuffle|Shuffle >
%Vl(shoff,78,670,148,27,2)
%Vf(292829)
%al%?ps<Shuffle|Shuffle >
#
%Vl(home,246,660,210,48,4)
%?mm< |  |   |    |     >
%?mm< |  |   |    |     >
%T(0,0,-,-,repmode)
%Vl(home,266,672,24,24,-)
%?mm<%xd(repp,1)|%xd(repp,2)|%xd(repp,3)|%xd(repp,2)|%xd(repp,2)>
%Vl(repon,300,670,148,27,2)
%Vf(ffffff)
%al%?mm<Repeat |Repeat|Repeat One|Repeat  |Repeat A-B>
%Vl(repoff,300,670,148,27,2)
%Vf(292829)
%al%?mm<Repeat |Repeat|Repeat One|Repeat  |Repeat A-B>
#
# ---------------- Mini player (other menus, while playing) ----------------
%Vl(mini,0,640,392,80,-)
%T(0,0,-,-,resumeplayback)
%Vl(mini,16,652,56,56,-)
%?C<%Cd%xd(mc1,1)%xd(mc2,2)%xd(mc3,3)%xd(mc4,4)|%xd(mnoart)>
%Vl(mini,88,654,296,27,2)
%Vf(292829)
%s%al%?it<%it|%fn>
%Vl(mini,88,684,296,23,3)
%Vf(6b6d6b)
%s%al%?ia<%ia|%?id<%id|>>
%Vl(mini,392,640,88,80,-)
%?mp<|%xd(mplay,2)|%xd(mplay,1)|%xd(mplay,2)|%xd(mplay,2)>
%T(0,0,-,-,play)
#
# ---------------- Quick screen ----------------
%Vl(qs,40,40,24,24,-)
%?bp<%xd(battc,%bl)|%xd(batt,%bl)>
%Vl(qs,72,38,100,27,2)
%Vf(292829)
%al%bl%%
%Vl(qs,200,40,24,24,-)
%?mh<%xd(lock)|>
%Vl(qs,392,16,80,72,-)
%T(0,0,-,-,cancel)
#
%Vl(qs,24,124,24,24,-)
%?if(%pv, <, -60)<%xd(volf,1)|%?if(%pv, <, -35)<%xd(volf,2)|%?if(%pv, <, -15)<%xd(volf,3)|%xd(volf,4)>>>
%Vl(qs,64,124,400,24,-)
%pv(0,0,400,24,seekfill.bmp,backdrop,seekbk,slider,seekknob)
%Vl(qs,24,180,24,24,-)
%xd(bright)
%Vl(qs,64,180,400,24,-)
%St(0,0,400,24,seekfill.bmp,backdrop,seekbk,slider,seekknob,setting,brightness)
