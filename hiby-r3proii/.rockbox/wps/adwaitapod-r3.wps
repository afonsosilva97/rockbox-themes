# Adwaitapod R3 (light) - while-playing screen
# HiBy R3 Pro II, 480x720 portrait, touchscreen
# Generated by src/adwaitapod-r3/make_skins.py from adwaitapod-r3.wps.in.
#
# Portrait touch redesign of adwaitapod by Dook (GPL-3.0):
# https://github.com/D0-0K/adwaitapod
#
# Layout (full screen; the base skin is off here)
#   0-64     back to the main menu, battery % and icon
#   64-424   album art, 360x360, rounded, on a soft shadow
#   446-547  title, artist, album
#   552-624  seek bar; times and playlist position. Changing the volume
#            shows a volume pop-up here for a moment.
#   632-712  shuffle, previous, play/pause, next, repeat
#
# Lock: Rockbox's key lock (power + volume up) shows a lock screen: clock,
# date and the playing track on a wallpaper.
#
# Same two layers as the base skin: backgrounds on the backdrop buffer (%VB),
# everything else above. Each screen starts with a full-screen viewport so
# switching between them repaints the whole screen.
#
# Fonts
%Fl(2,26-Cantarell-Bold.fnt)
%Fl(3,22-Cantarell-Regular.fnt)
%Fl(4,28-Cantarell-Bold.fnt)
%Fl(5,150-Cantarell-Light.fnt)
%Fl(6,36-Cantarell-Bold.fnt)
#
# Images for the backdrop layer (positions are on screen)
%xl(Bshadow,artshadow.bmp,44,48)
%xl(Bwall,wall.bmp,0,0)
%xl(Bcard,lcard.bmp,24,520)
%xl(Bosd,osd.bmp,40,556)
# Images for the foreground (positions are in their viewport)
%xl(back,back.bmp,0,0)
%xl(batt,batt.bmp,0,0,11)
%xl(battc,battc.bmp,0,0,11)
%xl(c1,corner.bmp,0,0,4)
%xl(c2,corner.bmp,344,0,4)
%xl(c3,corner.bmp,0,344,4)
%xl(c4,corner.bmp,344,344,4)
%xl(noart,noart.bmp,0,0)
%xl(seekbk,seekbk.bmp,0,0)
%xl(seekknob,seekknob.bmp,0,0)
%xl(shuf,shuf.bmp,26,26,2)
%xl(skip,skip.bmp,24,24,2)
%xl(play,play.bmp,0,8,2)
%xl(rep,rep.bmp,26,26,3)
%xl(volf,volf.bmp,0,0,4)
%xl(osdbk,osdbk.bmp,0,0)
%xl(osdknob,osdknob.bmp,0,0)
%xl(lockw,lockw.bmp,0,0)
%xl(battw,battw.bmp,0,0,11)
%xl(battcw,battcw.bmp,0,0,11)
%xl(lnote,lnote.bmp,0,0)
%xl(lplay,lplay.bmp,0,0,2)
#
# no base skin: this screen draws its own status row
%wd
#
# ---------------- Which parts show ----------------
%?mh<%Vd(lk)%?if(%mp, >, 1)<%Vd(lkc)>|%Vd(np)%?mv(1.5)<%Vd(osd)|%Vd(seek)>>
#
# ---------------- Backdrop layer ----------------
# (one line, as in the base skin)
%V(0,0,-,-,-)%VB
%?mh<%xd(Bwall)%?if(%mp, >, 1)<%xd(Bcard)>|%dr(0,0,-,-,f7f7f7)%xd(Bshadow)%?mv(1.5)<%xd(Bosd)|>>
#
# ---------------- Now playing ----------------
%Vl(np,0,0,480,720,-)
#
# back to the main menu: tap anywhere on the left of the top row
%Vl(np,0,0,96,64,-)
%T(0,0,-,-,menu)
%Vl(np,20,20,24,24,-)
%xd(back)
#
%Vl(np,356,20,72,23,3)
%Vf(292829)
%ar%bl%%
%Vl(np,436,20,24,24,-)
%?bp<%xd(battc,%bl)|%xd(batt,%bl)>
#
# album art with rounded corners; long-press for the context menu
%Vl(np,60,64,360,360,-)
%Cl(0,0,360,360,c,c)
%?C<%Cd%xd(c1,1)%xd(c2,2)%xd(c3,3)%xd(c4,4)|%xd(noart)>
%T(0,0,-,-,contextmenu,long_press)
#
%Vl(np,24,446,432,37,6)
%Vf(292829)
%s%ac%?it<%it|%fn>
%Vl(np,24,488,432,31,1)
%Vf(292829)
%s%ac%?ia<%ia|>
%Vl(np,24,524,432,23,3)
%Vf(6b6d6b)
%s%ac%?id<%id|>
#
# seek: the touch area is wider than the bar's 24 px; defined first, it also
# repaints the area after the volume pop-up
%Vl(seek,40,552,400,72,-)
%T(seek,0,0,-,-,progressbar)
%Vl(seek,40,562,400,24,-)
%pb(0,0,400,24,seekfill.bmp,backdrop,seekbk,slider,seekknob,notouch)
%Vl(seek,40,594,400,23,3)
%Vf(6b6d6b)
%al%pc%ac%?if(%pe, >, 1)<%pp of %pe|>%ar%pt
#
# ---------------- Controls ----------------
# Each control's viewport is its touch target; the icon is offset to its centre.
%Vl(np,16,632,80,80,-)
%?ps<%xd(shuf,2)|%xd(shuf,1)>
%T(0,0,-,-,shuffle)
#
# previous; hold to rewind
%Vl(np,100,632,80,80,-)
%xd(skip,1)
%T(0,0,-,-,rwd,repeat_press)
%T(0,0,-,-,wps_prev)
#
# play/pause; hold to stop
%Vl(np,180,632,120,80,-)
%?mp<%xd(play,1)|%xd(play,2)|%xd(play,1)|%xd(play,2)|%xd(play,2)>
%T(0,0,-,-,stop,long_press)
%T(0,0,-,-,play)
#
# next; hold to fast-forward
%Vl(np,300,632,80,80,-)
%xd(skip,2)
%T(0,0,-,-,ffwd,repeat_press)
%T(0,0,-,-,wps_next)
#
# repeat: off, all, one (shuffle mode and A-B show as all)
%Vl(np,384,632,80,80,-)
%?mm<%xd(rep,1)|%xd(rep,2)|%xd(rep,3)|%xd(rep,2)|%xd(rep,2)>
%T(0,0,-,-,repmode)
#
# ---------------- Volume pop-up ----------------
# The pill is on the backdrop, so the icon and bar clear to its colour. Blank
# lines that change with the pop-up repaint the pill when it appears.
%Vl(osd,40,556,400,64,4)
%?mv(1.5)< |  >
%?mv(1.5)< |  >
%?mv(1.5)< |  >
%Vl(osd,64,576,24,24,-)
%?if(%pv, <, -60)<%xd(volf,1)|%?if(%pv, <, -35)<%xd(volf,2)|%?if(%pv, <, -15)<%xd(volf,3)|%xd(volf,4)>>>
%Vl(osd,112,576,296,24,-)
%pv(0,0,296,24,osdfill.bmp,backdrop,osdbk,slider,osdknob,notouch)
#
# ---------------- Lock screen ----------------
%Vl(lk,0,0,480,720,-)
#
%Vl(lk,20,20,24,24,-)
%xd(lockw)
%Vl(lk,356,20,72,23,3)
%Vf(292829)
%ar%bl%%
%Vl(lk,436,20,24,24,-)
%?bp<%xd(battcw,%bl)|%xd(battw,%bl)>
#
%Vl(lk,0,120,480,151,5)
%Vf(292829)
%ac%?cf<%cH|%cl>:%cM
%Vl(lk,0,284,480,31,1)
%Vf(292829)
%ac%?cu<Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday> %?if(%ce, <, 10)<%ss(1,1,%ce)|%ce> %?cm<January|February|March|April|May|June|July|August|September|October|November|December>
#
# the playing track on a frosted card
%Vl(lkc,40,536,80,80,-)
%xd(lnote)
%Vl(lkc,136,546,256,29,4)
%Vf(292829)
%s%al%?it<%it|%fn>
%Vl(lkc,136,580,256,23,3)
%Vf(292829)
%s%al%?ia<%ia|%?id<%id|>>
%Vl(lkc,408,562,28,28,-)
%?mp<|%xd(lplay,2)|%xd(lplay,1)|%xd(lplay,2)|%xd(lplay,2)>
#
%Vl(lk,0,672,480,23,3)
%Vf(292829)
%acPower + Vol+ to unlock
